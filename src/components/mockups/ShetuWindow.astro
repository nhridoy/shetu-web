---
// Mirrors the client's layout/shell/Header.tsx (Windows/Linux controls).
import {
  ArrowsOutSimple,
  CaretDown,
  Code,
  FloppyDisk,
  Folder,
  GearSix,
  List,
  Minus,
  Plus,
  X,
} from '@phosphor-icons/react';

interface Props {
  /** Selected view. Leave unset when a terminal tab is active, as the app does. */
  view?: 'Vaults' | 'SFTP' | 'Editor';
  /** Open terminal tabs. The first is active when no view is selected. */
  tabs?: string[];
  /** Name of the open workspace, shown with its save buttons. */
  workspace?: string;
  class?: string;
}

const { view, tabs = [], workspace, class: className = '' } = Astro.props;
// The app uses the same folder icon for Vaults and SFTP.
const views = [
  { label: 'Vaults', Icon: Folder },
  { label: 'SFTP', Icon: Folder },
  { label: 'Editor', Icon: Code },
] as const;
---

<div
  aria-hidden="true"
  class:list={[
    '@container overflow-hidden rounded-xl border border-line-strong bg-[#08080b] text-left shadow-[0_40px_120px_-30px_rgba(0,0,0,0.9)] select-none',
    className,
  ]}
>
  <div class="flex h-10 items-center gap-1 border-b border-line bg-[#0b0b10] pl-2 text-[11px] text-muted">
    {/* The app swaps the Vault sidebar for this toggle on narrow windows. */}
    {view === 'Vaults' && <List size={13} className="mr-1 shrink-0 @4xl:hidden" />}
    <div class="flex shrink-0 items-center rounded-md bg-white/[0.04] p-0.5">
      {views.map(({ label, Icon }) => (
        <span
          class:list={[
            'flex items-center gap-1.5 rounded-[5px] px-2 py-1',
            label === view && 'bg-white/10 text-ink',
            label !== view && label !== 'Vaults' && 'hidden @xl:flex',
          ]}
        >
          <Icon size={12} />
          {label}
        </span>
      ))}
    </div>
    {view === 'Vaults' && (
      <span class="flex shrink-0 items-center gap-1.5 px-2 text-ink">
        <span class="h-2 w-2 rounded-full bg-accent"></span>
        Personal
        <CaretDown size={11} className="text-muted" />
      </span>
    )}
    {tabs.length > 0 && <span class="mx-1 h-4 w-px shrink-0 bg-white/10"></span>}
    {tabs.map((tab, i) => {
      const isActive = !view && i === 0;
      return (
        <span
          class:list={[
            'min-w-0 items-center gap-1.5 rounded-md px-2.5 py-1',
            isActive ? 'flex bg-white/[0.07] text-ink' : 'hidden @3xl:flex',
          ]}
        >
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-terminal-text"></span>
          <span class="truncate">{tab}</span>
          {isActive && <X size={10} className="ml-0.5 shrink-0" />}
        </span>
      );
    })}
    <Plus size={12} className="mx-1.5 hidden shrink-0 @lg:block" />
    <div class="ml-auto flex min-w-0 items-center gap-2.5">
      {workspace && (
        <span class="flex min-w-0 items-center gap-2">
          <span class="truncate rounded-md bg-white/[0.06] px-2 py-0.5">{workspace}</span>
          <FloppyDisk size={12} className="hidden shrink-0 opacity-40 @md:block" />
          <span class="relative hidden shrink-0 opacity-40 @md:block">
            <FloppyDisk size={12} />
            <Plus size={7} className="absolute -right-0.5 -bottom-0.5" />
          </span>
        </span>
      )}
      <span class="hidden @2xl:inline">Synced</span>
      <span class="hidden items-center gap-1.5 @2xl:flex">
        <span class="h-1.5 w-1.5 rounded-full bg-terminal-text"></span>Connected
      </span>
      <GearSix size={13} className="hidden @lg:block" />
      <span class="flex shrink-0 items-center">
        <span class="grid h-10 w-9 place-items-center"><Minus size={12} /></span>
        <span class="grid h-10 w-9 place-items-center"><ArrowsOutSimple size={11} /></span>
        <span class="grid h-10 w-9 place-items-center"><X size={12} /></span>
      </span>
    </div>
  </div>
  <slot />
</div>
