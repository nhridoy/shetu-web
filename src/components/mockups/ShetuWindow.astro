---
import {
  Code,
  Folder,
  FolderOpen,
  GearSix,
  Minus,
  Plus,
  Square,
  X,
} from '@phosphor-icons/react';

interface Props {
  tab?: 'Vaults' | 'SFTP' | 'Editor';
  title?: string;
  class?: string;
}

const {
  tab = 'Vaults',
  title = 'prod-api',
  class: className = '',
} = Astro.props;
const tabs = [
  { label: 'Vaults', Icon: Folder },
  { label: 'SFTP', Icon: FolderOpen },
  { label: 'Editor', Icon: Code },
] as const;
---

<div
  aria-hidden="true"
  class:list={[
    '@container overflow-hidden rounded-xl border border-line-strong bg-[#08080b] text-left shadow-[0_40px_120px_-30px_rgba(0,0,0,0.9)] select-none',
    className,
  ]}
>
  <div class="flex h-10 items-center gap-2 border-b border-line bg-[#0b0b10] px-2 text-[11px] text-muted">
    <div class="flex items-center gap-0.5 rounded-md bg-white/[0.03] p-0.5">
      {tabs.map(({ label, Icon }) => (
        <span
          class:list={[
            'flex items-center gap-1.5 rounded px-2 py-1',
            label === tab ? 'bg-white/10 text-ink' : 'hidden @xl:flex',
          ]}
        >
          <Icon size={12} />
          {label}
        </span>
      ))}
    </div>
    <span class="flex min-w-[5.5rem] shrink items-center gap-1.5 rounded-md border border-line px-2 py-1 text-ink">
      <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-terminal-text"></span>
      <span class="truncate">{title}</span>
    </span>
    <Plus size={12} className="hidden @lg:block" />
    <div class="ml-auto flex items-center gap-3">
      <span class="hidden @2xl:inline">Synced</span>
      <span class="hidden items-center gap-1.5 @2xl:flex">
        <span class="h-1.5 w-1.5 rounded-full bg-terminal-text"></span>Connected
      </span>
      <GearSix size={13} className="hidden @lg:block" />
      <span class="flex items-center gap-3 pl-1">
        <Minus size={12} />
        <Square size={10} />
        <X size={12} />
      </span>
    </div>
  </div>
  <slot />
</div>
