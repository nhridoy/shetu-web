---
import {
  ClockCounterClockwise,
  Desktop,
  FileText,
  Key,
  SquaresFour,
  UsersThree,
} from '@phosphor-icons/react';
import { DEMO_GROUPS } from './demo';

interface Props {
  active?: string;
  class?: string;
}

const { active = 'prod-api', class: className = '' } = Astro.props;
const nav = [
  { label: 'Hosts', Icon: Desktop },
  { label: 'Workspaces', Icon: SquaresFour },
  { label: 'Snippets', Icon: FileText },
  { label: 'Keys', Icon: Key },
  { label: 'History', Icon: ClockCounterClockwise },
  { label: 'Teams', Icon: UsersThree },
] as const;
---

<aside class:list={['flex w-52 shrink-0 flex-col gap-4 border-r border-line bg-[#0a0a0e] p-3 text-[11.5px]', className]}>
  <div>
    <p class="px-2 pb-1.5 text-[10px] font-semibold text-muted">Vault</p>
    {nav.map(({ label, Icon }) => (
      <div
        class:list={[
          'flex items-center gap-2 rounded-md px-2 py-1.5',
          label === 'Hosts' ? 'bg-white/[0.07] font-semibold text-ink' : 'text-muted',
        ]}
      >
        <Icon size={13} />
        {label}
      </div>
    ))}
  </div>
  {DEMO_GROUPS.map((group) => (
    <div>
      <p class="px-2 pb-1 font-mono text-[9.5px] uppercase tracking-[0.14em] text-muted">{group.name}</p>
      {group.hosts.map((host) => (
        <div
          class:list={[
            'flex items-center gap-2 rounded-md px-2 py-1',
            host.name === active ? 'bg-accent/15 text-ink ring-1 ring-accent/30' : 'text-muted',
          ]}
        >
          <span
            class="grid h-4 w-4 shrink-0 place-items-center rounded text-[8.5px] font-bold text-paper"
            style={`background:${host.color}`}
          >
            {host.name[0]?.toUpperCase()}
          </span>
          <span class="truncate font-mono text-[10.5px]">{host.name}</span>
          <span
            class:list={[
              'ml-auto h-1.5 w-1.5 shrink-0 rounded-full',
              host.online ? 'bg-terminal-text' : 'bg-white/20',
            ]}
          ></span>
        </div>
      ))}
    </div>
  ))}
</aside>
