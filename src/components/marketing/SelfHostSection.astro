---
import { ArrowRight, Check } from '@phosphor-icons/react';

const points = [
  'Go server with PostgreSQL',
  'Multi-arch Docker image for amd64 and arm64',
  'Email sign-in, plus Google and GitHub OAuth',
  'Teams with owner, admin and member roles',
];
const lines = [
  { c: '# generate a JWT_SECRET for compose.yaml', comment: true },
  { c: 'openssl rand -base64 48' },
  { c: 'docker compose up -d' },
  { c: '✔ shetu-server  Started', out: true },
];
---

<section id="self-host" class="scroll-mt-20">
  <div class="mx-auto grid max-w-[1200px] items-center gap-12 px-5 py-20 sm:px-6 md:py-28 lg:grid-cols-2 lg:gap-16">
    <div class="reveal">
      <p class="eyebrow">Self-host</p>
      <h2 class="mt-4 text-balance text-4xl leading-[1.05] font-bold md:text-5xl">
        Run the sync server yourself.
      </h2>
      <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted">
        Sync, sign-in and shared vaults go through a Shetu server. It is open
        source too, so you can run it on your own box and keep every byte where
        you want it.
      </p>
      <ul class="mt-7 space-y-3">
        {points.map((point) => (
          <li class="flex items-start gap-3 text-[15px] text-ink/90">
            <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-accent-wash text-accent">
              <Check size={11} weight="bold" />
            </span>
            {point}
          </li>
        ))}
      </ul>
      <a href="/docs/server" class="link mt-8 inline-flex items-center gap-1.5 text-sm font-medium">
        Read the server guide <ArrowRight size={13} />
      </a>
    </div>

    <div class="reveal relative min-w-0">
      <div class="glow-beam pointer-events-none absolute -inset-6 opacity-50" aria-hidden="true"></div>
      <figure class="relative overflow-hidden rounded-xl border border-line-strong bg-terminal shadow-2xl shadow-black/60">
        <div class="flex items-center gap-2 border-b border-line px-4 py-2.5 font-mono text-[11px] text-muted">
          <span class="h-1.5 w-1.5 rounded-full bg-terminal-text"></span>
          you@server: ~/shetu
          <span class="ml-auto">ghcr.io/nhridoy/shetu-server</span>
        </div>
        <pre class="overflow-x-auto p-5 font-mono text-[12.5px] leading-[1.9]"><code>{lines.map((l) => (
          <span class:list={['block', l.comment ? 'text-muted' : l.out ? 'text-terminal-text' : 'text-ink']}>{!l.comment && !l.out && <span class="text-accent">$ </span>}{l.c}</span>
        ))}</code></pre>
        <figcaption class="border-t border-line px-4 py-2.5 text-xs text-muted">
          Using the compose.yaml from the server guide.
        </figcaption>
      </figure>
    </div>
  </div>
</section>
