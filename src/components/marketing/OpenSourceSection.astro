---
import { ArrowRight, ArrowUpRight, GithubLogo } from '@phosphor-icons/react';
import { REPOS } from '../../lib/site';

const repos = [
  {
    name: 'shetu',
    href: REPOS.monorepo,
    description: 'Project home, docs and issues. Start here.',
    stack: ['Monorepo', 'MIT'],
  },
  {
    name: 'shetu-client',
    href: REPOS.client,
    description: 'The desktop app for macOS, Windows and Linux.',
    stack: ['Tauri v2', 'Rust', 'React', 'TypeScript'],
  },
  {
    name: 'shetu-server',
    href: REPOS.server,
    description: 'Sync, accounts and teams. Runs anywhere Docker does.',
    stack: ['Go', 'Gin', 'GORM', 'PostgreSQL'],
  },
  {
    name: 'shetu-web',
    href: REPOS.web,
    description: 'This website and the documentation.',
    stack: ['Astro', 'Tailwind', 'MDX'],
  },
];
---

<section id="open-source" class="scroll-mt-20">
  <div class="mx-auto max-w-[1200px] px-5 py-20 sm:px-6 md:py-28">
    <div class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow">Open source</p>
        <h2 class="mt-4 text-balance text-4xl leading-[1.05] font-bold md:text-5xl">Built in the open.</h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Every line of the client, the server and this site is on GitHub under
          the MIT license. Read it, fork it, or send a pull request.
        </p>
      </div>
      <a href="/community" class="link inline-flex shrink-0 items-center gap-1.5 text-sm font-medium">
        How to contribute <ArrowRight size={13} />
      </a>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {repos.map((repo) => (
        <a href={repo.href} class="panel lift reveal group flex flex-col p-6">
          <div class="flex items-center gap-2.5">
            <GithubLogo size={18} weight="fill" className="text-muted" />
            <span class="font-mono text-sm text-muted">nhridoy/<span class="font-semibold text-ink">{repo.name}</span></span>
            <ArrowUpRight size={15} className="ml-auto text-muted transition-colors group-hover:text-accent" />
          </div>
          <p class="mt-3 text-[15px] text-muted">{repo.description}</p>
          <div class="mt-5 flex flex-wrap gap-1.5">
            {repo.stack.map((s) => (
              <span class="rounded-full border border-line px-2.5 py-0.5 font-mono text-[10.5px] text-muted">{s}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
