---
import {
  ArrowsLeftRight,
  ClockCounterClockwise,
  FolderOpen,
  GitBranch,
  Key,
  Palette,
  SquaresFour,
  TerminalWindow,
} from '@phosphor-icons/react';
import { DEMO_GROUPS } from '../mockups/demo';

const hosts = DEMO_GROUPS.flatMap((group) =>
  group.hosts.map((host) => ({ ...host, group: group.name })),
).slice(0, 4);
const swatches = [
  '#8b7cff',
  '#5b8cff',
  '#7ee2a8',
  '#f5a524',
  '#f472b6',
  '#e5484d',
  '#38bdf8',
  '#e8e8ef',
];
const forwards = [
  { mode: 'L', label: 'Local', from: '5432', to: 'prod-db-01:5432' },
  { mode: 'R', label: 'Remote', from: '8080', to: 'localhost:3000' },
  { mode: 'D', label: 'SOCKS5', from: '1080', to: 'edge-sg' },
];
const tile = 'panel lift reveal relative flex flex-col overflow-hidden p-6';
const title = 'mt-4 text-lg font-bold tracking-[-0.02em]';
const body = 'mt-1.5 text-[15px] leading-relaxed text-muted';
const icon =
  'grid h-9 w-9 place-items-center rounded-lg border border-line bg-white/[0.03] text-accent';
---

<section id="features" class="scroll-mt-20">
  <div class="mx-auto max-w-[1200px] px-5 py-20 sm:px-6 md:py-28">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">Features</p>
      <h2 class="mt-4 text-balance text-4xl leading-[1.05] font-bold md:text-[3.25rem]">
        Everything you open Termius for. Free.
      </h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
        Terminals, hosts, files, tunnels and keys in one desktop app, built on
        Tauri and Rust. No feature is held back for a paid plan.
      </p>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-6">
      <!-- Terminal -->
      <article class:list={[tile, 'md:col-span-4']}>
        <div class={icon}><TerminalWindow size={18} /></div>
        <h3 class={title}>Split terminals and tabs</h3>
        <p class={body}>
          A GPU-rendered xterm.js terminal. Split panes side by side or stacked,
          drag tabs to reorder, and open a local shell next to your servers.
        </p>
        <div class="mt-6 grid flex-1 grid-cols-3 gap-2 font-mono text-[10.5px]" aria-hidden="true">
          <div class="col-span-2 row-span-2 rounded-lg border border-line bg-terminal p-3">
            <p><span class="text-terminal-text">deploy@prod-api:~$</span> htop</p>
            <div class="mt-2 space-y-1.5">
              {[72, 38, 54, 21].map((v, i) => (
                <div class="flex items-center gap-2 text-muted">
                  <span class="w-6">cpu{i}</span>
                  <span class="h-1.5 flex-1 rounded-full bg-white/5">
                    <span class="block h-full rounded-full bg-gradient-to-r from-accent to-accent-2" style={`width:${v}%`}></span>
                  </span>
                  <span class="w-8 text-right">{v}%</span>
                </div>
              ))}
            </div>
          </div>
          <div class="rounded-lg border border-line bg-terminal p-3 text-muted">
            <p><span class="text-terminal-text">db-01$</span> psql</p>
            <p class="mt-1">terra=#</p>
          </div>
          <div class="rounded-lg border border-line bg-terminal p-3 text-muted">
            <p><span class="text-terminal-text">me$</span> make dev</p>
            <p class="mt-1">ready :1420</p>
          </div>
        </div>
      </article>

      <!-- Hosts -->
      <article class:list={[tile, 'md:col-span-2']}>
        <div class={icon}><SquaresFour size={18} /></div>
        <h3 class={title}>Hosts, grouped your way</h3>
        <p class={body}>Nested groups, tags, colors and OS icons. Drag hosts between groups.</p>
        <div class="mt-6 space-y-1.5" aria-hidden="true">
          {hosts.map((host) => (
            <div class="flex items-center gap-2.5 rounded-lg border border-line bg-white/[0.02] px-2.5 py-2 text-xs">
              <span class="grid h-5 w-5 place-items-center rounded text-[9px] font-bold text-paper" style={`background:${host.color}`}>
                {host.name[0]?.toUpperCase()}
              </span>
              <span class="font-mono text-[11px] text-ink">{host.name}</span>
              <span class="ml-auto rounded-full border border-line px-1.5 py-0.5 font-mono text-[9px] text-muted">{host.group}</span>
            </div>
          ))}
        </div>
      </article>

      <!-- SFTP -->
      <article class:list={[tile, 'md:col-span-2']}>
        <div class={icon}><FolderOpen size={18} /></div>
        <h3 class={title}>SFTP, side by side</h3>
        <p class={body}>
          Local and remote panes. Drag to upload, rename, chmod, chown, and
          resolve conflicts without leaving the app.
        </p>
        <div class="mt-6 flex items-center gap-2 font-mono text-[10.5px] text-muted" aria-hidden="true">
          <span class="flex-1 truncate rounded-lg border border-line bg-white/[0.02] px-2.5 py-2">~/dist.tar.gz</span>
          <span class="text-accent">→</span>
          <span class="flex-1 truncate rounded-lg border border-accent/30 bg-accent-wash px-2.5 py-2 text-ink">/srv/api</span>
        </div>
        <div class="mt-2 h-1 overflow-hidden rounded-full bg-white/5" aria-hidden="true">
          <div class="h-full w-2/3 rounded-full bg-gradient-to-r from-accent to-accent-2"></div>
        </div>
      </article>

      <!-- Port forwarding -->
      <article class:list={[tile, 'md:col-span-2']}>
        <div class={icon}><ArrowsLeftRight size={18} /></div>
        <h3 class={title}>Port forwarding</h3>
        <p class={body}>Local, remote and dynamic SOCKS5 tunnels, saved and synced with your hosts.</p>
        <div class="mt-6 space-y-1.5 font-mono text-[10.5px]" aria-hidden="true">
          {forwards.map((fwd) => (
            <div class="flex items-center gap-2 rounded-lg border border-line bg-white/[0.02] px-2.5 py-1.5 text-muted">
              <span class="grid h-4 w-4 place-items-center rounded bg-accent-wash text-[9px] font-bold text-accent">{fwd.mode}</span>
              <span class="text-ink">:{fwd.from}</span>
              <span>→</span>
              <span class="truncate">{fwd.to}</span>
            </div>
          ))}
        </div>
      </article>

      <!-- Keys -->
      <article class:list={[tile, 'md:col-span-2']}>
        <div class={icon}><Key size={18} /></div>
        <h3 class={title}>Keys built in</h3>
        <p class={body}>
          Generate Ed25519, RSA 4096 or ECDSA P-256 keys, or import OpenSSH and
          PEM keys, passphrase included.
        </p>
        <div class="mt-6 flex flex-wrap gap-1.5 font-mono text-[10.5px]" aria-hidden="true">
          {['ed25519', 'rsa-4096', 'ecdsa-p256', 'openssh', 'pem'].map((k, i) => (
            <span class:list={['rounded-full border px-2.5 py-1', i === 0 ? 'border-accent/40 bg-accent-wash text-ink' : 'border-line text-muted']}>{k}</span>
          ))}
        </div>
      </article>

      <!-- Editor + Git -->
      <article class:list={[tile, 'md:col-span-2']}>
        <div class={icon}><GitBranch size={18} /></div>
        <h3 class={title}>Editor with Git</h3>
        <p class={body}>
          Edit remote files over SFTP in a CodeMirror editor with about 20
          languages, diffs, and a Git panel for local projects.
        </p>
        <div class="mt-6 rounded-lg border border-line bg-terminal p-3 font-mono text-[10.5px] leading-relaxed" aria-hidden="true">
          <p class="text-[#ff8a8a]">- listen 80</p>
          <p class="text-terminal-text">+ listen 443 ssl</p>
          <p class="text-muted">  server_name api.local;</p>
        </div>
      </article>

      <!-- Themes -->
      <article class:list={[tile, 'md:col-span-2']}>
        <div class={icon}><Palette size={18} /></div>
        <h3 class={title}>36 themes, 8 fonts</h3>
        <p class={body}>
          Every theme restyles the whole workspace and its terminal colors.
          JetBrains Mono, Fira Code, Iosevka and more.
        </p>
        <div class="mt-6 flex gap-1.5" aria-hidden="true">
          {swatches.map((color) => (
            <span class="h-7 flex-1 rounded-md ring-1 ring-white/10" style={`background:${color}`}></span>
          ))}
        </div>
      </article>

      <!-- History -->
      <article class:list={[tile, 'md:col-span-2']}>
        <div class={icon}><ClockCounterClockwise size={18} /></div>
        <h3 class={title}>Encrypted session history</h3>
        <p class={body}>
          Opt in to record terminal sessions. Recordings are encrypted, synced,
          and kept for 7, 30 or 90 days.
        </p>
        <div class="mt-6 flex gap-1.5 font-mono text-[10.5px]" aria-hidden="true">
          {['7 days', '30 days', '90 days'].map((d, i) => (
            <span class:list={['flex-1 rounded-lg border py-1.5 text-center', i === 1 ? 'border-accent/40 bg-accent-wash text-ink' : 'border-line text-muted']}>{d}</span>
          ))}
        </div>
      </article>
    </div>
  </div>
</section>
