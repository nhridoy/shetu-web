---
import { GithubLogo } from '@phosphor-icons/react';
import { REPOS } from '../../lib/site';
import Logo from '../brand/Logo.astro';
import DownloadPanel from '../download/DownloadPanel';
---

<section class="relative border-t border-line">
  <!-- Only the decoration is clipped, so the download menu can open past the section. -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="glow-beam absolute inset-x-0 top-1/3 mx-auto h-72 max-w-3xl"></div>
    <div class="dot-grid absolute inset-0"></div>
  </div>
  <div class="reveal relative mx-auto max-w-3xl px-5 py-24 text-center sm:px-6 md:py-32">
    <Logo size={52} class="justify-center" />
    <h2 class="mt-8 text-balance text-4xl leading-[1.05] font-bold md:text-6xl">
      Your servers deserve a better client.
    </h2>
    <p class="mx-auto mt-5 max-w-lg text-lg text-muted">
      Free, open source, and yours to keep. Every feature, no account tiers,
      no trial clock.
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <DownloadPanel client:visible variant="hero" />
      <a href={REPOS.monorepo} class="btn-ghost px-5 py-3">
        <GithubLogo size={16} weight="fill" /> View source
      </a>
    </div>
  </div>
</section>
