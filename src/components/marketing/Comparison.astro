---
import { Check, X } from '@phosphor-icons/react';

type Cell = { yes: boolean; text: string };
const rows: { label: string; terra: Cell; termius: Cell }[] = [
  {
    label: 'Price',
    terra: { yes: true, text: 'Free, MIT licensed' },
    termius: { yes: true, text: 'Free Starter plan; Pro $10/mo' },
  },
  {
    label: 'Source code',
    terra: { yes: true, text: 'Open (MIT)' },
    termius: { yes: false, text: 'Closed' },
  },
  {
    label: 'Self-host the sync server',
    terra: { yes: true, text: 'Docker or binary' },
    termius: { yes: false, text: 'Not offered' },
  },
  {
    label: 'Encrypted sync across devices',
    terra: { yes: true, text: 'Free with your server' },
    termius: { yes: true, text: 'Pro plan' },
  },
  {
    label: 'Shared team vaults',
    terra: { yes: true, text: 'Free with your server' },
    termius: { yes: true, text: 'Team plan, $20/seat/mo' },
  },
  {
    label: 'SSH, SFTP, port forwarding',
    terra: { yes: true, text: 'Yes' },
    termius: { yes: true, text: 'Yes' },
  },
  {
    label: 'Mobile apps',
    terra: { yes: false, text: 'No' },
    termius: { yes: true, text: 'iOS and Android' },
  },
  {
    label: 'Mosh and Telnet',
    terra: { yes: false, text: 'No' },
    termius: { yes: true, text: 'Yes' },
  },
];
interface Props {
  /** Link to the full Termius alternative page; off on that page itself. */
  more?: boolean;
}

const { more = true } = Astro.props;
---

<section id="compare" class="scroll-mt-20">
  <div class="mx-auto max-w-[1000px] px-5 py-20 sm:px-6 md:py-28">
    <div class="reveal text-center">
      <p class="eyebrow">Compare</p>
      <h2 class="mt-4 text-balance text-4xl leading-[1.05] font-bold md:text-5xl">
        Terra and Termius, side by side.
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-muted">
        Termius is a polished product. Here is an honest look at where each one
        fits, including where Termius is ahead.
      </p>
    </div>

    <div
      class="panel reveal mt-12 overflow-x-auto"
      tabindex="0"
      role="region"
      aria-label="Terra and Termius comparison table"
    >
      <table class="w-full min-w-[560px] border-collapse text-left text-sm">
        <caption class="sr-only">Feature and price comparison of Terra and Termius</caption>
        <thead>
          <tr class="border-b border-line">
            <th scope="col" class="w-[38%] px-5 py-4 font-mono text-[11px] font-medium tracking-[0.14em] text-muted uppercase"><span class="sr-only">Feature</span></th>
            <th scope="col" class="w-[31%] bg-accent-wash/60 px-5 py-4 text-base font-bold text-ink">Terra</th>
            <th scope="col" class="w-[31%] px-5 py-4 text-base font-bold text-muted">Termius</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b border-line last:border-0">
              <th scope="row" class="px-5 py-3.5 font-medium text-ink/90">{row.label}</th>
              {[row.terra, row.termius].map((cell, i) => (
                <td class:list={['px-5 py-3.5', i === 0 && 'bg-accent-wash/60']}>
                  <span class="flex items-center gap-2.5">
                    {cell.yes ? (
                      <Check size={15} weight="bold" className={i === 0 ? 'shrink-0 text-accent' : 'shrink-0 text-ink/70'} aria-hidden="true" />
                    ) : (
                      <X size={15} weight="bold" className="shrink-0 text-muted" aria-hidden="true" />
                    )}
                    <span class={i === 0 ? 'text-ink' : 'text-muted'}>{cell.text}</span>
                  </span>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-center text-xs text-muted">
      Termius prices as listed on{" "}
      <a href="https://termius.com/pricing" class="link">termius.com/pricing</a>,
      November 2026. Paid plans billed annually. Termius is a trademark of its
      owner.
    </p>
    {more && (
      <p class="mt-6 text-center">
        <a href="/termius-alternative" class="link text-sm font-medium">
          Switching from Termius? Read the full comparison
        </a>
      </p>
    )}
  </div>
</section>
