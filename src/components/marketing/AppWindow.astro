---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  title?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  image,
  alt,
  title = 'Terra',
  widths = [640, 960, 1366],
  sizes = '(min-width: 1200px) 560px, 100vw',
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className = '',
} = Astro.props;
---

<div
  class:list={[
    'overflow-hidden rounded-2xl border border-line bg-surface shadow-2xl shadow-black/50',
    className,
  ]}
>
  <div class="flex items-center gap-1.5 border-b border-line px-4 py-2.5">
    <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
    <span
      class="ml-2 font-mono text-[10px] uppercase tracking-[0.16em] text-muted"
    >
      {title}
    </span>
  </div>
  <Image
    src={image}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={loading}
    fetchpriority={fetchpriority}
    class="h-auto w-full"
  />
</div>
