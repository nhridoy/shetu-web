---
interface Props {
  code: string;
  label?: string;
}

const { code, label = 'shell' } = Astro.props;
---

<div class="overflow-hidden rounded-xl border border-line-strong bg-terminal">
  <div class="flex items-center justify-between border-b border-line px-4 py-2.5">
    <span class="font-mono text-[11px] text-muted">
      {label}
    </span>
    <button
      type="button"
      data-copy={code}
      class="rounded-md border border-line px-2.5 py-1 font-mono text-[11px] text-muted transition-colors duration-150 hover:border-accent/40 hover:text-ink"
    >
      Copy
    </button>
  </div>
  <pre
    class="overflow-x-auto p-4 font-mono text-[12.5px] leading-relaxed text-ink"><code
      >{code}</code
    ></pre>
</div>
