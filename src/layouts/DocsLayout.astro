---
import type { CollectionEntry } from 'astro:content';
import DocsNav from '../components/docs/DocsNav.astro';
import BaseLayout from './BaseLayout.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  headings?: Heading[];
  prev?: CollectionEntry<'docs'> | null;
  next?: CollectionEntry<'docs'> | null;
}

const {
  title,
  description,
  headings = [],
  prev = null,
  next = null,
} = Astro.props;
const toc = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

<BaseLayout title={`${title} · Terra Docs`} description={description}>
  <div class="mx-auto grid max-w-[1200px] gap-10 px-5 sm:px-6 py-10 lg:grid-cols-[210px_minmax(0,1fr)_190px] lg:py-14">
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <details class="panel p-4 lg:hidden">
        <summary class="cursor-pointer font-mono text-[11px] uppercase tracking-[0.18em] text-muted">
          Docs menu
        </summary>
        <div class="mt-4">
          <DocsNav />
        </div>
      </details>
      <div class="hidden lg:block">
        <DocsNav />
      </div>
    </aside>

    <article class="min-w-0">
      <p class="eyebrow">
        Documentation
      </p>
      <h1
        class="mt-3 text-balance text-4xl font-bold md:text-5xl"
      >
        {title}
      </h1>
      <p class="mt-3 max-w-2xl text-lg leading-relaxed text-muted">
        {description}
      </p>
      <div class="docs-prose mt-10">
        <slot />
      </div>

      <nav
        class="mt-12 flex flex-col gap-4 border-t border-line pt-6 sm:flex-row sm:justify-between"
        aria-label="Docs pagination"
      >
        {prev ? (
          <a
            href={`/docs/${prev.id}`}
            class="link text-sm font-medium"
          >
            ← {prev.data.title}
          </a>
        ) : (
          <span></span>
        )}
        {next ? (
          <a
            href={`/docs/${next.id}`}
            class="link text-sm font-medium sm:text-right"
          >
            {next.data.title} →
          </a>
        ) : (
          <span></span>
        )}
      </nav>
    </article>

    <aside class="hidden lg:block">
      {toc.length > 0 && (
        <nav class="sticky top-24" aria-label="On this page">
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">
            On this page
          </p>
          <ul class="mt-3 space-y-2 border-l border-line">
            {toc.map((heading) => (
              <li class:list={[heading.depth === 3 ? 'pl-6' : 'pl-3']}>
                <a
                  href={`#${heading.slug}`}
                  class="block text-sm text-muted hover:text-ink"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </aside>
  </div>
</BaseLayout>
