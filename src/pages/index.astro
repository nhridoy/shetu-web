---
import ClosingCta from '../components/marketing/ClosingCta.astro';
import CloudTeaser from '../components/marketing/CloudTeaser.astro';
import Comparison from '../components/marketing/Comparison.astro';
import FactStrip from '../components/marketing/FactStrip.astro';
import FaqSection from '../components/marketing/FaqSection.astro';
import FeatureBento from '../components/marketing/FeatureBento.astro';
import FeatureShowcase from '../components/marketing/FeatureShowcase.astro';
import Hero from '../components/marketing/Hero.astro';
import OpenSourceSection from '../components/marketing/OpenSourceSection.astro';
import SecurityFlow from '../components/marketing/SecurityFlow.astro';
import SelfHostSection from '../components/marketing/SelfHostSection.astro';
import AppSidebar from '../components/mockups/AppSidebar.astro';
import SftpPanes from '../components/mockups/SftpPanes.astro';
import ShetuWindow from '../components/mockups/ShetuWindow.astro';
import TerminalPane from '../components/mockups/TerminalPane.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { latestRelease, loadReleases } from '../lib/changelog';
import { PAGES, softwareJsonLd } from '../lib/seo';

// Mirrors the client's teams/managers/TeamManager.tsx, seen by the team owner.
const members = [
  { name: 'Aisha K.', email: 'aisha@acme.dev', role: 'owner' },
  { name: 'Marco R.', email: 'marco@acme.dev', role: 'admin' },
  { name: 'Lin W.', email: 'lin@acme.dev', role: 'member' },
  { name: 'Sam T.', email: 'sam@acme.dev', role: 'member' },
];
const teams = [
  { name: 'Platform', members: 4 },
  { name: 'Homelab', members: 2 },
];
const roleBadge: Record<string, string> = {
  owner: 'bg-purple-500/20 text-purple-400',
  admin: 'bg-blue-500/20 text-blue-400',
  member: 'bg-white/10 text-muted',
};
const latest = latestRelease(await loadReleases());
---

<BaseLayout
  {...PAGES['/']}
  jsonLd={softwareJsonLd(latest)}
>
  <Hero />
  <FactStrip />
  <FeatureBento />

  <FeatureShowcase
    id="files"
    eyebrow="Files"
    title="Files without a second app."
    body="Open an SFTP browser next to your terminal, drag files across, and edit remote config in place. Saving writes straight back to the server."
    bullets={[
      'Local and remote panes with drag and drop',
      'Rename, chmod, chown, symlinks and search',
      'Edit remote files in the built-in editor',
    ]}
  >
    <p class="sr-only">Shetu SFTP view with a local folder on the left and the prod-api server on the right.</p>
    <ShetuWindow view="SFTP" tabs={['prod-api']}>
      <SftpPanes />
    </ShetuWindow>
  </FeatureShowcase>

  <FeatureShowcase
    id="workspaces"
    eyebrow="Workspaces"
    title="Pick up where you left off."
    body="Save a layout of tabs and split panes once, then bring the whole set back with one click when you return to the task."
    bullets={[
      'Save and restore tab and pane layouts',
      'Mix remote hosts and local shells',
      'Focus mode on F11',
    ]}
    side="left"
  >
    <p class="sr-only">A saved workspace with three terminals: two servers and a local shell.</p>
    <ShetuWindow tabs={['prod-api', 'staging-web']} workspace="release-day">
      <div class="grid h-[300px] grid-cols-2 grid-rows-2">
        <TerminalPane
          title="prod-api"
          active
          lines={[{ prompt: 'prod-api$', cmd: 'systemctl status api', out: ['● api.service: active (running)'] }]}
          class="row-span-2 border-r border-line"
        />
        <TerminalPane
          title="prod-db-01"
          lines={[{ prompt: 'db-01$', cmd: 'pg_isready', out: ['accepting connections'] }]}
          class="border-b border-line"
        />
        <TerminalPane
          title="Local"
          lines={[{ prompt: 'me$', cmd: 'make release', out: ['tagged v2.4.0'] }]}
        />
      </div>
    </ShetuWindow>
  </FeatureShowcase>

  <FeatureShowcase
    id="teams"
    eyebrow="Teams"
    title="Share a vault, not a password."
    body="Create a team on your Shetu server, invite people, and share the hosts they need. Each shared vault has its own key, sealed to every member."
    bullets={[
      'Owner, admin and member roles',
      'Shared vaults with their own keys',
      'Remove someone, then rotate the vault key in one click',
    ]}
  >
    <p class="sr-only">Shetu Teams page showing the Platform team and its four members with owner, admin and member roles.</p>
    <ShetuWindow view="Vaults">
      <div class="flex text-[11px]">
        <AppSidebar active="Teams" class="hidden @4xl:flex" />
        <div class="min-w-0 flex-1">
          <div class="flex items-center justify-between border-b border-line px-3 py-2.5">
            <p class="text-[13px] font-semibold text-ink">Teams</p>
            <span class="rounded-md bg-accent px-2 py-1 font-medium text-paper">+ New Team</span>
          </div>
          <div class="flex">
            <div class="hidden w-32 shrink-0 border-r border-line @xl:block">
              {teams.map((team, i) => (
                <div
                  class:list={[
                    'flex items-center gap-2 border-b border-line p-2',
                    i === 0 && 'border-l-2 border-l-accent bg-accent/20',
                  ]}
                >
                  <span class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-white/10 font-medium text-ink">{team.name[0]}</span>
                  <span class="min-w-0">
                    <span class="block truncate font-medium text-ink">{team.name}</span>
                    <span class="block text-[10px] text-muted">{team.members} members</span>
                  </span>
                </div>
              ))}
            </div>
            <div class="min-w-0 flex-1 p-3">
              <div class="flex items-center justify-between gap-2">
                <p class="text-[15px] font-bold text-ink">Platform</p>
                <span class="flex shrink-0 gap-1.5">
                  <span class="hidden rounded-md px-2 py-1 text-ink @2xl:inline">Rename</span>
                  <span class="rounded-md bg-accent px-2 py-1 font-medium text-paper">Invite Member</span>
                  <span class="hidden rounded-md bg-red-600 px-2 py-1 font-medium text-white @3xl:inline">Delete Team</span>
                </span>
              </div>
              <div class="mt-3 rounded-lg bg-white/[0.04] p-3">
                <p class="font-medium text-ink">Members ({members.length})</p>
                <div class="mt-2 space-y-1.5">
                  {members.map((m) => (
                    <div class="flex items-center gap-2.5 rounded-lg bg-white/[0.05] px-2.5 py-2">
                      <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-white/10 text-ink">{m.name[0]}</span>
                      <span class="min-w-0 flex-1">
                        <span class="block truncate text-ink">{m.name}</span>
                        <span class="block truncate text-[10px] text-muted">{m.email}</span>
                      </span>
                      <span class:list={['rounded px-2 py-0.5 text-[10px]', roleBadge[m.role]]}>{m.role}</span>
                      {m.role !== 'owner' && (
                        <span class="hidden items-center gap-1.5 @2xl:flex">
                          <span class="rounded border border-line px-1.5 py-0.5 text-[10px] text-muted">{m.role === 'admin' ? 'Admin' : 'Member'} ▾</span>
                          <span class="text-muted">×</span>
                        </span>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </ShetuWindow>
  </FeatureShowcase>

  <SecurityFlow />
  <SelfHostSection />
  <Comparison />
  <CloudTeaser />
  <OpenSourceSection />
  <FaqSection />
  <ClosingCta />
</BaseLayout>
