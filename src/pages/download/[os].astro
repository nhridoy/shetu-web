---
import { DownloadSimple } from '@phosphor-icons/react';
import DownloadPanel from '../../components/download/DownloadPanel';
import Callout from '../../components/ui/Callout.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { latestRelease, loadReleases } from '../../lib/changelog';
import { type GuideOs, OS_GUIDES } from '../../lib/os-guides';
import { formatBytes, mapAssets } from '../../lib/releases';
import { breadcrumbJsonLd, PAGES, softwareJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return (Object.keys(OS_GUIDES) as GuideOs[]).map((os) => ({
    params: { os },
    props: { os },
  }));
}

const { os } = Astro.props as { os: GuideOs };
const guide = OS_GUIDES[os];
const latest = latestRelease(await loadReleases());
const builds = mapAssets(latest).filter((asset) => asset.os === os);
const others = (Object.keys(OS_GUIDES) as GuideOs[]).filter((o) => o !== os);
const path = `/download/${os}` as const;
---

<BaseLayout
  {...PAGES[path]}
  jsonLd={[
    softwareJsonLd(latest, os),
    breadcrumbJsonLd([
      { name: 'Download', path: '/download' },
      { name: guide.label, path },
    ]),
  ]}
>
  <PageHeader
    eyebrow={`Download for ${guide.label}`}
    title={`Free open-source SSH client for ${guide.label}.`}
    lede={`Terra runs on ${guide.label} (${guide.archs}) with split terminals, SFTP, port forwarding and an encrypted vault. Free, MIT licensed, no account tiers.`}
  >
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <DownloadPanel client:idle={{ timeout: 1000 }} variant="hero" targetOs={os} />
      <a href="/download" class="btn-ghost px-5 py-3">All platforms</a>
    </div>
  </PageHeader>

  <section class="mx-auto grid max-w-[1200px] grid-cols-1 gap-12 px-5 py-14 sm:px-6 md:py-20 lg:grid-cols-2">
    <div>
      <h2 class="text-3xl font-bold">Install with one command</h2>
      <p class="mt-3 text-muted">
        Open {guide.shell} and run:
      </p>
      <div class="mt-5">
        <CodeBlock code={guide.command} label={guide.shell} />
      </div>
      <p class="mt-3 text-sm leading-relaxed text-muted">{guide.installNote}</p>
    </div>
    <div>
      <h2 id="builds" class="scroll-mt-24 text-3xl font-bold">Or download {latest.tag_name}</h2>
      <p class="mt-3 text-muted">Available as: {guide.formats.join(', ')}.</p>
      <ul class="panel mt-5 divide-y divide-line p-2">
        {builds.map((asset) => (
          <li class="flex items-center justify-between gap-3 px-3 py-3">
            <div>
              <p class="text-sm font-medium">{asset.label}</p>
              <p class="font-mono text-xs text-muted">{formatBytes(asset.size)}</p>
            </div>
            <a
              href={asset.url}
              class="inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-line px-3 py-1.5 text-xs font-semibold transition-colors hover:border-accent/50 hover:bg-accent-wash"
            >
              <DownloadSimple size={13} aria-hidden="true" /> Download
              <span class="sr-only"> {asset.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-sm text-muted">
        Newer builds and older versions are in the{' '}
        <a href="/changelog" class="link">changelog</a>.
      </p>
    </div>
  </section>

  <section class="border-y border-line bg-surface/40">
    <div class="mx-auto grid max-w-[1200px] gap-10 px-5 py-14 sm:px-6 md:py-20 lg:grid-cols-3">
      <div>
        <h2 class="text-2xl font-bold">First launch</h2>
        <div class="mt-4">
        <Callout tone="warning" title={guide.label}>
          <ol class="list-decimal space-y-1.5 pl-4">
            {guide.firstLaunch.map((step) => <li>{step}</li>)}
          </ol>
        </Callout>
        </div>
      </div>
      <div>
        <h2 class="text-2xl font-bold">Updates</h2>
        <p class="mt-4 leading-relaxed text-muted">{guide.updates}</p>
        <p class="mt-3 leading-relaxed text-muted">
          You also need direct SSH access to your hosts and a Terra server for
          sign-in and sync. You can <a href="/self-hosted" class="link">run your own</a>.
        </p>
      </div>
      <div>
        <h2 class="text-2xl font-bold">Uninstall</h2>
        <p class="mt-4 leading-relaxed text-muted">{guide.uninstall}</p>
        <p class="mt-3 leading-relaxed text-muted">
          To delete local data too, remove <code class="font-mono text-sm text-ink">{guide.dataDir}</code>.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-5 py-14 sm:px-6">
    <h2 class="text-2xl font-bold">Other platforms</h2>
    <div class="mt-5 flex flex-wrap gap-3">
      {others.map((o) => (
        <a href={`/download/${o}`} class="btn-ghost">Terra for {OS_GUIDES[o].label}</a>
      ))}
      <a href="/docs/desktop" class="btn-ghost">Desktop app guide</a>
    </div>
  </section>
</BaseLayout>
