---
import TerminalPane from '../components/mockups/TerminalPane.astro';
import TerraWindow from '../components/mockups/TerraWindow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found · Terra"
  description="The page you requested does not exist."
  noindex
>
  <section class="relative overflow-hidden">
    <div class="dot-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-[1200px] items-center gap-12 px-5 py-20 sm:px-6 md:py-28 lg:grid-cols-2">
      <div>
        <p class="eyebrow">404</p>
        <h1 class="mt-5 text-balance text-5xl leading-[1.02] font-bold tracking-[-0.045em] md:text-6xl">
          Host not found.
        </h1>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-muted">
          This page is not in the vault. Try the homepage, the docs or the
          download page.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/" class="btn-primary">Home</a>
          <a href="/download" class="btn-ghost">Download</a>
          <a href="/docs" class="btn-ghost">Docs</a>
        </div>
      </div>
      <div class="relative">
        <div class="glow-beam pointer-events-none absolute -inset-8 opacity-60" aria-hidden="true"></div>
        <TerraWindow title="ssh" class="relative">
          <TerminalPane
            title="me@laptop"
            lines={[
              {
                prompt: 'me@laptop:~$',
                cmd: 'ssh this-page',
                out: ['ssh: Could not resolve hostname this-page: Name or service not known'],
              },
            ]}
            class="h-56"
          />
        </TerraWindow>
      </div>
    </div>
  </section>
</BaseLayout>
